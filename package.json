{
  "name": "aitutorial",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, narrated programming lesson harness",
  "type": "module",
  "bin": {
    "aitutorial": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --packages=external --platform=node --target=node20 --format=esm --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:acceptance": "npm run build && vitest run tests/acceptance.test.ts",
    "check": "npm run typecheck && npm test && npm run test:acceptance"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "vite": "^6.4.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
